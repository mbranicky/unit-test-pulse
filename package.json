{
  "name": "paseo-unit-test-pulse",
  "version": "1.0.0",
  "files": [
    "paseo-plugin.json",
    "npm-shrinkwrap.json",
    "RELEASE_NOTES.md",
    "RELEASING.md",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "skills/",
    "README.md",
    "LICENSE",
    "!**/*.test.mjs",
    "assets/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "setup:compat": "npm ci --prefix tests/compat/vitest4 --ignore-scripts && node node_modules/bun/install.js",
    "pack:release": "node scripts/package.mjs",
    "test:package": "node scripts/check-package.mjs",
    "typecheck:paseo-011": "node scripts/check-paseo-sdk.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "24.0.0",
    "@types/react": "~19.2.0",
    "bun": "1.4.3",
    "jasmine": "7.0.0",
    "jasmine6": "npm:jasmine@6.3.0",
    "jest": "30.5.2",
    "mocha": "12.0.3",
    "mocha11": "npm:mocha@11.8.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "vitest": "5.0.4",
    "zod": "^4.4.3"
  },
  "description": "Live JavaScript and TypeScript unit test diagnostics for Paseo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "bin": {
    "unit-test-pulse": "server/cli.mjs"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbranicky/unit-test-pulse.git"
  },
  "homepage": "https://github.com/mbranicky/unit-test-pulse#readme",
  "bugs": {
    "url": "https://github.com/mbranicky/unit-test-pulse/issues"
  },
  "author": "mbranicky",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "testing",
    "vitest",
    "jest",
    "mocha",
    "bun",
    "jasmine",
    "node-test"
  ],
  "publishConfig": {
    "access": "public"
  }
}
