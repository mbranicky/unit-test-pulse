{
  "id": "unit-test-pulse",
  "name": "Unit Test Pulse",
  "description": "Live unit test progress, failures, stack traces, and logs alongside your Paseo agents.",
  "requirements": {
    "paseo": ">=0.11.2 <0.14.0"
  },
  "media": [
    "assets/running.png",
    "assets/failure.png",
    "assets/skill-setup.png",
    "assets/light.png",
    "assets/test-details.png",
    "assets/logs.png",
    "assets/source-preview.png",
    "assets/recent-runs.png",
    "assets/settings.png"
  ],
  "build": [["npm", "ci", "--omit=dev", "--ignore-scripts"]]
}
